# Pooled Neon connection string (required at runtime, NOT at build time)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Required to force a refresh via POST /api/refresh?force=1 (send as x-refresh-token header or ?token=)
REFRESH_TOKEN=change-me-to-a-long-random-string
